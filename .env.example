# Typesense — copy to .env.local for `next dev`, and export for the scripts.
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_ADMIN_API_KEY=devkey          # server-side only (indexing)
NEXT_PUBLIC_TYPESENSE_SEARCH_API_KEY=devkey   # search-only key; scope this down in prod
NEXT_PUBLIC_TYPESENSE_HOST=localhost
NEXT_PUBLIC_TYPESENSE_PORT=8108
NEXT_PUBLIC_TYPESENSE_PROTOCOL=http
NEXT_PUBLIC_TYPESENSE_COLLECTION=meetings

# Chatbot (Ask Fellow) — set in Vercel (server-side only; never NEXT_PUBLIC).
# Get the key at console.anthropic.com. If unset, the /api/chat route returns 503 and
# the app simply keeps working in Search mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Server-side Typesense search key for the chat route (falls back to the public one).
TYPESENSE_SEARCH_API_KEY=devkey

# Map tiles (production). Get a free key at maptiler.com. If unset, the app falls
# back to OpenStreetMap raster tiles (fine for local dev only).
NEXT_PUBLIC_MAPTILER_KEY=

# Optional: Google Maps Embed API key (free) → enables inline Street View + Google
# map on the detail sheet. Without it, the detail map uses MapTiler/OSM and Street
# View opens in Google Maps in a new tab. Enable "Maps Embed API" on the key.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Live feeds for ingest (see scripts/ingest.mjs)
AA_FEED_URL=https://aa-dc.org/wp-admin/admin-ajax.php?action=meetings
NA_BMLT_URL=https://bmlt.cprna.org/main_server/client_interface/json/?switcher=GetSearchResults&lat_val=38.9072&long_val=-77.0369&geo_width=-15&data_field_key=meeting_name,weekday_tzid,start_time,duration_time,location_text,location_street,location_municipality,location_province,latitude,longitude,formats,comments
