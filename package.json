{
  "name": "fellow-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "lint": "next lint",
    "typesense:up": "docker compose up -d typesense",
    "typesense:down": "docker compose down",
    "ingest": "node scripts/ingest.mjs",
    "index": "node scripts/index.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "bootstrap": "npm run typesense:up && npm run ingest && npm run index",
    "bootstrap:local": "npm run typesense:up && npm run ingest -- --local && npm run index"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "maplibre-gl": "^4.7.1",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-instantsearch": "^7.15.0",
    "typesense": "^2.0.3",
    "typesense-instantsearch-adapter": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.7.0"
  }
}
